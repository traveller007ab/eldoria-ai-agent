{
  "name": "eldoria-ai-agent",
  "private": true,
  "version": "1.0.0",
  "description": "Eldoria AI IDE - Sentient Academic Co-Pilot",
  "author": "Eldoria Team",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "concurrently -k \"npm run dev\" \"npm run bridge\"",
    "bridge": "python services/bridge.py",
    "prebuild": "node -e \"const fs=require('fs'); const src='release/eldoria-bridge-win.exe'; const dest='public/downloads/eldoria-bridge-win.exe'; if(fs.existsSync(src)){fs.mkdirSync('public/downloads',{recursive:true});fs.copyFileSync(src,dest);console.log('Bridge exe copied for production build')}else{console.log('No bridge exe found in release/ - skipping')}\"",
    "build": "vite build",
    "postbuild": "node -e \"const fs=require('fs'); const p='public/downloads/eldoria-bridge-win.exe'; if(fs.existsSync(p)){fs.unlinkSync(p);console.log('Cleaned up bridge exe from public')}\"",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:pack": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@google/genai": "^1.19.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/react-router-dom": "^5.3.3",
    "electron-updater": "^6.6.2",
    "groq-sdk": "^0.37.0",
    "katex": "^0.16.27",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.12.2",
    "node-fetch": "^2.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.11.0",
    "react-syntax-highlighter": "^15.5.0",
    "reactflow": "^11.11.4",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.14.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.eldoria.aiide",
    "productName": "Eldoria AI IDE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "services/**/*",
      "projects/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
